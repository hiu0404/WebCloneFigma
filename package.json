{
  "name": "webclonefigma",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm exec -- vite",
    "dev:server": "node server/index.js",
    "admin:setup": "node scripts/admin-setup.mjs",
    "admin:reset-account": "node scripts/admin-reset-account.mjs",
    "build": "npm exec -- tsc -b && npm exec -- vite build",
    "lint": "npm exec -- eslint .",
    "preview": "npm exec -- vite preview",
    "prod": "npm run build && node scripts/run-prod.mjs",
    "start": "node scripts/run-prod.mjs",
    "start:dev": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.75.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
